{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionString": "Host=localhost;Port=5432;Database=AuraAPX;Username=postgres;Password=1234",
  "Security": {
    "SecurityLevel": 12
  },
  "Auth": {
    "JwtAccessTokenSettings": {
      "Issuer": "AuraAPXServer",
      "Audience": "AuraAPXClient",
      "Key": "my_super_secret_key_minimum_1024_characters_long",
      "Expires": 10
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "AuraAPX",
    "RefreshTokenTtlDays": 30
  }
}
